# Debezium Server configuration
debezium.sink.type = http
debezium.sink.http.url = http://host.docker.internal:8000/debezium/events
debezium.sink.http.timeout.ms = 5000

# Source - Neon PostgreSQL
debezium.source.connector.class = io.debezium.connector.postgresql.PostgresConnector
debezium.source.offset.storage.file.filename = /debezium/data/offsets.dat
debezium.source.offset.flush.interval.ms = 0

# Neon connection - fill with your actual values
debezium.source.database.hostname = your_neon_host
debezium.source.database.port = 5432
debezium.source.database.user = debezium_role
debezium.source.database.password = your_debezium_password
debezium.source.database.dbname = neondb
debezium.source.database.sslmode = require

# Replication config
debezium.source.plugin.name = pgoutput
debezium.source.slot.name = debezium
debezium.source.publication.name = debezium_publication

# Tables to monitor
debezium.source.table.include.list = public.documents,public.courses,public.users

# Topic naming
debezium.source.topic.prefix = capiapi